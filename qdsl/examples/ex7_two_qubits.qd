// ';' is strictly sequential; parallelism is written down.
qubit Q1, Q2;
place Q1 on board0.core1, Q2 on board0.core2;
parallel {
    X90(Q1);
|
    X90(Q2);
}
CNOT(Q2, Q1);                  // after both X90s (join)
parallel {                     // on two cores both readouts are scheduled
    measure(Q1);               // in the same clock (not promised by parallel)
|
    measure(Q2);
}
