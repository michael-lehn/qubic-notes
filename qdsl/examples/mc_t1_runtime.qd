// T1 sweep on two qubits at once with a runtime delay: delay(tau) shifts the
// clock of every core by the same amount, so the cores stay aligned.
qubit Q0, Q1;
REP :: 100 us;
tau : time = 0 us;
n := 0;
do {
    par { { X90(Q0); X90(Q0); } { X90(Q1); X90(Q1); } }
    delay(tau);
    par { { measure(Q0); } { measure(Q1); } }
    delay(REP);
    tau += 10 us;
    n += 1;
} while n < 3;
