diff -ru --ex a/distproc/ir/instructions.py b/distproc/ir/instructions.py
--- a/distproc/ir/instructions.py	2026-10-22 19:47:41
+++ b/distproc/ir/instructions.py	2026-10-22 21:22:40
@@ -527,6 +527,21 @@
         return instr_dict
 
 @define
+class IncQclk:
+    """
+    Add the value of register `var` (in clocks) to qclk on every core in scope.
+    A negative value makes every later timestamp on those cores fire that much
+    later, i.e. a runtime delay. All cores that must stay aligned have to be
+    in scope. Statically it is scheduled as a barrier plus one ALU instruction.
+    """
+    var: str
+    scope: List[str] | Set[str] | Tuple[str] = field(default=None, converter=_normalize_scope)
+    name: str = field(default='inc_qclk')
+
+    def to_dict(self) -> Dict:
+        return {'name': self.name, 'var': self.var, 'scope': self.scope}
+
+@define
 class Halt:
     scope: List[str] | Set[str] | Tuple[str] = field(default=None, converter=_normalize_scope)
     name: str = field(default='halt')
